---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import Base from "../../components/Base.astro";
import menu from "../../data/menu.json";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  function getPostOrder(filePath: string | undefined) {
    const filename = filePath?.split(/[\\/]/).at(-1);
    const match = filename?.match(/^\[(\d+)\]/);

    if (!match) {
      throw new Error(`Unable to read post order from "${filePath ?? "unknown file"}".`);
    }

    return Number(match[1]);
  }

  return menu.flatMap(({ category, title, order }) => {
    if (!/^[\w-]+$/.test(category)) {
      throw new Error(`Invalid category "${category}" in src/data/menu.json.`);
    }

    if (order !== "asc" && order !== "desc") {
      throw new Error(`Invalid order "${order}" for category "${category}".`);
    }

    if (!existsSync(resolve(process.cwd(), "content", category))) {
      return [];
    }

    const categoryPosts = posts
      .filter((post) => post.id.startsWith(`${category}/`))
      .sort((a, b) => getPostOrder(a.filePath) - getPostOrder(b.filePath));

    if (order === "desc") {
      categoryPosts.reverse();
    }

    return [{ params: { slug: category }, props: { title, posts: categoryPosts } }];
  });
}

const { title, posts: categoryPosts } = Astro.props;
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const description = `${title} 카테고리의 포스트 목록입니다.`;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const structuredData = {
  "@type": "CollectionPage",
  "@id": `${canonicalURL.href}#collection`,
  url: canonicalURL.href,
  name: title,
  description,
  isPartOf: { "@id": new URL("#website", siteURL).href },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: categoryPosts.map((post, index) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "BlogPosting",
          name: post.data.title,
          description: post.data.description,
          url: new URL(`/post/${encodeURIComponent(postSlug)}`, siteURL).href,
        },
      };
    }),
  },
};
---

<Base props={{ title, description, canonicalURL, structuredData }}>
  <nav>
    <h1>{title}</h1>
    {categoryPosts.map((post) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return (
        <ul>
          <li class="post-items">
            <div class="post-title"><span class="icon document-16"></span> <a href={`/post/${postSlug}`}>{post.data.title}</a></div>
            <div class="post-description"><span class="icon megaphone-16"></span> {post.data.description}</div>
            <div class="post-updated"><span class="icon calendar-16"></span> updated: {post.data.updated}</div>
          </li>
        </ul>
      );
    })}
  </nav>
</Base>

<style>
  nav {
    max-width: 740px;
    margin: 0 auto;
  }

  nav > h1 {
    margin: 0 0 30px;
    color: #20343a;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  nav ul {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .post-items {
    padding: 22px 24px;
    border: 1px solid #e5ded2;
    background: #fffdf8;
    box-shadow: 0 5px 18px rgb(54 44 30 / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-items:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 24px rgb(54 44 30 / 9%);
  }

  .post-title {
    margin-bottom: 9px;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .post-title a {
    color: #20343a;
    text-decoration: none;
  }

  .post-title a:hover,
  .post-title a:focus-visible {
    color: #a04f32;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    color: #586568;
  }

  .post-updated {
    margin-top: 14px;
    color: #85877f;
    font-size: 0.82rem;
  }

  .post-title .icon,
  .post-description .icon,
  .post-updated .icon {
    margin-right: 4px;
  }

  @media (max-width: 600px) {
    .post-items {
      padding: 18px;
    }

    .post-title {
      font-size: 1.15rem;
    }
  }
</style>
