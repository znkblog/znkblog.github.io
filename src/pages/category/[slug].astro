---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import Base from "../../components/Base.astro";
import menu from "../../data/menu.json";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  function getPostOrder(filePath: string | undefined) {
    const filename = filePath?.split(/[\\/]/).at(-1);
    const match = filename?.match(/^\[(\d+)\]/);

    if (!match) {
      throw new Error(`Unable to read post order from "${filePath ?? "unknown file"}".`);
    }

    return Number(match[1]);
  }

  return menu.flatMap(({ category, title, order }) => {
    if (!/^[\w-]+$/.test(category)) {
      throw new Error(`Invalid category "${category}" in src/data/menu.json.`);
    }

    if (order !== "asc" && order !== "desc") {
      throw new Error(`Invalid order "${order}" for category "${category}".`);
    }

    if (!existsSync(resolve(process.cwd(), "content", category))) {
      return [];
    }

    const categoryPosts = posts
      .filter((post) => post.id.startsWith(`${category}/`))
      .sort((a, b) => getPostOrder(a.filePath) - getPostOrder(b.filePath));

    if (order === "desc") {
      categoryPosts.reverse();
    }

    return [{ params: { slug: category }, props: { title, posts: categoryPosts } }];
  });
}

const { title, posts: categoryPosts } = Astro.props;
---

<Base>
  <nav>
    <h1>{title}</h1>
    {categoryPosts.map((post) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return (
        <ul>
          <li class="post-items">
            <div class="post-title"><span class="icon document-16"></span> <a href={`/post/${postSlug}`}>{post.data.title}</a></div>
            <div class="post-description"><span class="icon megaphone-16"></span> {post.data.description}</div>
            <div class="post-updated"><span class="icon calendar-16"></span> updated: {post.data.updated}</div>
          </li>
        </ul>
      );
    })}
  </nav>
</Base>
