---
import { getCollection, render } from "astro:content";
import Base from "../../components/Base.astro";
import menu from "../../data/menu.json";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categories = new Set(menu.map(({ category }) => category));

  return posts.flatMap((post) => {
    const separatorIndex = post.id.indexOf("/");
    const category = post.id.slice(0, separatorIndex);

    if (separatorIndex === -1 || !categories.has(category)) {
      return [];
    }

    return [{
      params: { slug: post.id.slice(separatorIndex + 1) },
      props: { post },
    }];
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base>
  <article>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <Content />
  </article>
</Base>
