---
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => {
    const separatorIndex = post.id.indexOf("/");

    if (separatorIndex === -1) {
      throw new Error(`Invalid post ID "${post.id}". Expected "<category>/<slug>".`);
    }

    return {
      params: { slug: post.id.slice(separatorIndex + 1) },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const postSlug = post.id.slice(post.id.indexOf("/") + 1);
const canonicalURL = new URL(`/post/${encodeURIComponent(postSlug)}`, siteURL);
const structuredData = {
  "@type": "BlogPosting",
  "@id": `${canonicalURL.href}#article`,
  url: canonicalURL.href,
  headline: post.data.title,
  description: post.data.description,
  dateModified: post.data.updated,
  keywords: post.data.tags,
  inLanguage: "ko",
  mainEntityOfPage: { "@id": `${canonicalURL.href}#webpage` },
  publisher: { "@id": new URL("#organization", siteURL).href },
};
---

<Post
  frontmatter={{
    title: post.data.title,
    description: post.data.description,
    canonicalURL,
    type: "article",
    structuredData,
  }}
>
  <Content />
</Post>
