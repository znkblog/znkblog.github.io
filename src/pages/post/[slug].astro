---
import { getCollection, render } from "astro:content";
import Base from "../../components/Base.astro";
import menu from "../../data/menu.json";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categories = new Set(menu.map(({ category }) => category));

  return posts.flatMap((post) => {
    const separatorIndex = post.id.indexOf("/");
    const category = post.id.slice(0, separatorIndex);

    if (separatorIndex === -1 || !categories.has(category)) {
      return [];
    }

    return [{
      params: { slug: post.id.slice(separatorIndex + 1) },
      props: { post },
    }];
  });
}

const { post } = Astro.props;
const { Content } = await render(post);
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const postSlug = post.id.slice(post.id.indexOf("/") + 1);
const canonicalURL = new URL(`/post/${encodeURIComponent(postSlug)}`, siteURL);
const structuredData = {
  "@type": "BlogPosting",
  "@id": `${canonicalURL.href}#article`,
  url: canonicalURL.href,
  headline: post.data.title,
  description: post.data.description,
  dateModified: post.data.updated,
  keywords: post.data.tags,
  inLanguage: "ko",
  mainEntityOfPage: { "@id": `${canonicalURL.href}#webpage` },
  publisher: { "@id": new URL("#organization", siteURL).href },
};
---

<Base
  props={{
    title: post.data.title,
    description: post.data.description,
    canonicalURL,
    type: "article",
    structuredData,
  }}
>
  <article>
    <h1>{post.data.title}</h1>
    <p>{post.data.description}</p>
    <Content />
  </article>
</Base>

<style>
  article {
    max-width: 740px;
    margin: 0 auto;
    padding: clamp(26px, 5vw, 54px);
    border: 1px solid #e8e0d4;
    border-radius: 16px;
    background: #fffdf8;
    box-shadow: 0 12px 40px rgb(54 44 30 / 7%);
  }

  article > h1:first-child {
    margin: 0 0 14px;
    color: #20343a;
    font-family: Georgia, "Noto Serif KR", serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    letter-spacing: -0.045em;
  }

  article > p:first-of-type {
    margin: 0 0 34px;
    padding-bottom: 26px;
    border-bottom: 1px solid #e9e1d6;
    color: #687578;
    font-size: 1.08rem;
  }

  article :global(h1),
  article :global(h2),
  article :global(h3),
  article :global(h4),
  article :global(h5),
  article :global(h6) {
    margin: 1.8em 0 0.65em;
    color: #263d43;
    font-family: Georgia, "Noto Serif KR", serif;
    line-height: 1.3;
  }

  article :global(h1:not(:first-child)) {
    font-size: 2rem;
  }

  article :global(h2) {
    padding-bottom: 0.35em;
    border-bottom: 1px solid #e8e0d4;
    font-size: 1.7rem;
  }

  article :global(h3) {
    font-size: 1.4rem;
  }

  article :global(h4) {
    font-size: 1.2rem;
  }

  article :global(h5) {
    font-size: 1.05rem;
  }

  article :global(h6) {
    color: #85877f;
    font-size: 0.95rem;
  }

  article :global(p),
  article :global(ul),
  article :global(ol) {
    margin: 0 0 1.15em;
  }

  article :global(ul),
  article :global(ol) {
    padding-left: 1.6em;
  }

  article :global(ul) {
    list-style: disc;
  }

  article :global(ol) {
    list-style: decimal;
  }

  article :global(li + li) {
    margin-top: 0.35em;
  }

  article :global(blockquote) {
    margin: 1.5em 0;
    padding: 14px 20px;
    border-left: 4px solid #bd7955;
    border-radius: 0 8px 8px 0;
    color: #586568;
    background: #f5f0e7;
  }

  article :global(blockquote > :last-child) {
    margin-bottom: 0;
  }

  article :global(hr) {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid #e5ded2;
  }

  article :global(a) {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  article :global(img),
  article :global(svg) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  article :global(pre) {
    overflow-x: auto;
    margin: 1.5em 0;
    padding: 20px;
    border: 1px solid #263d43;
    border-radius: 10px;
    color: #edf3ee;
    background: #20343a;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  article :global(code) {
    font-family: "Cascadia Code", Consolas, monospace;
  }

  article :global(:not(pre) > code) {
    padding: 0.15em 0.4em;
    border-radius: 4px;
    color: #8b452f;
    background: #f2e9dd;
    font-size: 0.9em;
  }

  article :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 1.5em 0;
    border-collapse: collapse;
    font-size: 0.94rem;
  }

  article :global(th),
  article :global(td) {
    padding: 10px 13px;
    border: 1px solid #e2d9cc;
    text-align: left;
  }

  article :global(th) {
    color: #20343a;
    background: #f2ede4;
  }

  article :global(tr:nth-child(even) td) {
    background: #faf7f1;
  }

  article :global(input[type="checkbox"]) {
    margin-right: 0.5em;
    accent-color: #52756a;
  }

  article :global(kbd) {
    padding: 0.15em 0.45em;
    border: 1px solid #d2c9bc;
    border-radius: 4px;
    background: #f5f0e7;
    box-shadow: 0 1px 0 #d2c9bc;
    font-family: inherit;
    font-size: 0.85em;
  }

  article :global(details) {
    margin: 1.25em 0;
    padding: 12px 16px;
    border: 1px solid #e5ded2;
    border-radius: 8px;
    background: #faf7f1;
  }

  article :global(summary) {
    color: #263d43;
    cursor: pointer;
    font-weight: 700;
  }

  article :global(mark) {
    padding: 0.1em 0.25em;
    background: #f4df9b;
  }

  @media (max-width: 600px) {
    article {
      padding: 22px 18px;
      border-radius: 12px;
    }

    article :global(pre) {
      padding: 15px;
    }
  }
</style>
