---
import Base from '../components/Base.astro';
import { parse } from 'yaml';
import categorySource from '../blog.yaml?raw';

type Frontmatter = {
  title: string;
  description: string;
  updated: string;
};

type MarkdownModule = {
  frontmatter: Frontmatter;
};

type BlogCategory = {
  id: string;
  name: string;
  order: 'asc' | 'desc';
};

const posts = import.meta.glob<MarkdownModule>('../content/**/*.md', { eager: true });
const categories = parse(categorySource) as BlogCategory[] ?? [];

const blogCategories = categories.map((category) => {
  const categoryPath = `../content/${category.id}/`;
  const multiplier = category.order === 'desc' ? -1 : 1;

  const entries = Object.entries(posts)
    .filter(([path]) => path.startsWith(categoryPath))
    .filter(([path]) => /^\[[^\]]+\].+\.md$/.test(path.split('/').pop() ?? ''))
    .map(([path, post]) => {
      const fileName = path.split('/').pop() ?? '';
      const [, sequence, slug] = fileName.match(/^\[([^\]]+)\](.+)\.md$/)!;

      return { frontmatter: post.frontmatter, sequence, slug };
    })
    .sort((left, right) => left.sequence.localeCompare(right.sequence, undefined, { numeric: true }) * multiplier);

  return { ...category, entries };
});


---

<Base>
  <main>
    <form id="blog-search" role="search">
      <div class="search-controls">
        <input id="blog-search-input" type="search" placeholder="찾고 싶은 포스팅 제목 입력하고 Enter 키를 누르세요" aria-label="Search posts by title" />
      </div>
    </form>
    <div>아래 보이는 카테고리를 클릭하면 해당 포스팅들이 표시됨</div>
    {
      blogCategories.map((category) => (
        <section class="cat">
          <details class="blog-category">
            <summary>
          <h2>{category.name}</h2>
            </summary>
          {category.entries.length > 0 ? (
            <ul>
              {category.entries.map(({ frontmatter, slug }) => (
                <li data-post data-title={frontmatter.title}>
                  <article>
                    <h3>📌 <a data-post-title href={`/blog/${slug}`}>{frontmatter.title}</a></h3>
                    <div>📢 {frontmatter.description}</div>
                    <div>🗓️ Last updated: {frontmatter.updated.slice(0, 10)}</div>
                  </article>
                </li>
              ))}
            </ul>
          ) : (
            <small>해당 카테고리에는 포스팅이 없습니다.</small>
          )}
          </details>
        </section>
      ))
    }
  </main>
  <script>
    const form = document.querySelector('#blog-search');
    const input = document.querySelector('#blog-search-input');
    const posts = Array.from(document.querySelectorAll('[data-post]'));
    const categories = Array.from(document.querySelectorAll<HTMLDetailsElement>('.blog-category'));
    const emptyCategoryMessages = Array.from(document.querySelectorAll('main > section > p'));

    function setTitleHighlight(titleElement: Element, title: string, query: string) {
      const normalizedTitle = title.toLocaleLowerCase();
      const normalizedQuery = query.toLocaleLowerCase();
      const matchIndex = normalizedTitle.indexOf(normalizedQuery);

      titleElement.replaceChildren();

      if (matchIndex === -1 || query === '') {
        titleElement.textContent = title;
        return;
      }

      titleElement.append(
        document.createTextNode(title.slice(0, matchIndex)),
        Object.assign(document.createElement('mark'), { textContent: title.slice(matchIndex, matchIndex + query.length) }),
        document.createTextNode(title.slice(matchIndex + query.length)),
      );
    }

    function resetSearch() {
      posts.forEach((post) => {
        post.hidden = false;
        const title = post.dataset.title ?? '';
        const titleElement = post.querySelector('[data-post-title]');

        if (titleElement) setTitleHighlight(titleElement, title, '');
      });
      emptyCategoryMessages.forEach((message) => { message.hidden = false; });
      categories.forEach((category) => { category.open = false; });
    }

    function runSearch() {
      const query = input instanceof HTMLInputElement ? input.value.trim() : '';
      if (query === '') return;

      posts.forEach((post) => {
        const title = post.dataset.title ?? '';
        const isMatch = title.toLocaleLowerCase().includes(query.toLocaleLowerCase());
        post.hidden = !isMatch;

        const titleElement = post.querySelector('[data-post-title]');
        if (titleElement) setTitleHighlight(titleElement, title, isMatch ? query : '');
      });
      emptyCategoryMessages.forEach((message) => { message.hidden = true; });
      categories.forEach((category) => {
        category.open = category.querySelector('[data-post]:not([hidden])') !== null;
      });
    }

    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      runSearch();
    });

    input?.addEventListener('input', () => {
      if (input instanceof HTMLInputElement && input.value.trim() === '') resetSearch();
    });
  </script>
</Base>

<style>
  #blog-search {
    margin: 3rem 0;
  }

  .cat {
    margin: 3rem 0;
  }

  .search-controls {
    display: flex;
    align-items: center;
    /* gap: var(--pico-spacing); */
  }

  .search-controls input,
  .search-controls button {
    margin-bottom: 0;
  }

  .search-controls input {
    flex: 1;
  }

  .search-controls button {
    width: auto;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
  }

  .blog-category summary {
    cursor: pointer;
    list-style: none;
  }

  .blog-category summary::-webkit-details-marker {
    display: none;
  }

  /* .blog-category summary::before {
    content: '▷';
  }

  .blog-category[open] summary::before {
    content: '▽';
  } */

  .blog-category summary h2 {
    display: inline-block;
  }
</style>
