---
import { type CollectionEntry } from "astro:content";
import Base from "./Base.astro";

interface Props {
  title: string;
  posts: CollectionEntry<"posts">[];
}

const { title, posts } = Astro.props;
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const description = `${title} 카테고리의 포스트 목록입니다.`;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const structuredData = {
  "@type": "CollectionPage",
  "@id": `${canonicalURL.href}#collection`,
  url: canonicalURL.href,
  name: title,
  description,
  isPartOf: { "@id": new URL("#website", siteURL).href },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "BlogPosting",
          name: post.data.title,
          description: post.data.description,
          url: new URL(`/post/${encodeURIComponent(postSlug)}`, siteURL).href,
        },
      };
    }),
  },
};
---

<Base props={{ title, description, canonicalURL, structuredData }}>
  <nav>
    <h1>{title}</h1>
    <input
      class="category-search"
      type="text"
      placeholder="검색어를 입력하고 엔터키 누르세요"
      aria-label="카테고리 포스트 검색"
    />
    {posts.map((post) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return (
        <ul>
          <li class="post-items">
            <div class="post-title"><a href={`/post/${postSlug}`}>{post.data.title}</a></div>
            <div class="post-description">{post.data.description}</div>
            <div class="post-meta">
              <div class="post-updated">{post.data.updated}</div>
              {post.data.tags.map((tag) => <span class="post-tag">{tag}</span>)}
            </div>
          </li>
        </ul>
      );
    })}
  </nav>
</Base>

<script>
  const searchInput = document.querySelector<HTMLInputElement>(".category-search");
  const postItems = Array.from(document.querySelectorAll<HTMLLIElement>(".post-items"));

  if (!searchInput) {
    throw new Error("Category search input is missing.");
  }

  function clearHighlights(post: HTMLLIElement) {
    post.querySelectorAll("mark.search-highlight").forEach((mark) => {
      mark.replaceWith(document.createTextNode(mark.textContent ?? ""));
    });
    post.normalize();
  }

  function highlightMatches(post: HTMLLIElement, query: string) {
    const walker = document.createTreeWalker(post, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    let node: Node | null;

    while ((node = walker.nextNode())) {
      if (node instanceof Text && node.textContent.toLocaleLowerCase().includes(query)) {
        textNodes.push(node);
      }
    }

    for (const textNode of textNodes) {
      const text = textNode.textContent ?? "";
      const lowerText = text.toLocaleLowerCase();
      const fragment = document.createDocumentFragment();
      let cursor = 0;
      let matchIndex = lowerText.indexOf(query, cursor);

      while (matchIndex !== -1) {
        fragment.append(text.slice(cursor, matchIndex));
        const mark = document.createElement("mark");
        mark.className = "search-highlight";
        mark.textContent = text.slice(matchIndex, matchIndex + query.length);
        fragment.append(mark);
        cursor = matchIndex + query.length;
        matchIndex = lowerText.indexOf(query, cursor);
      }

      fragment.append(text.slice(cursor));
      textNode.replaceWith(fragment);
    }
  }

  function showAllPosts() {
    for (const post of postItems) {
      clearHighlights(post);
      post.hidden = false;
    }
  }

  searchInput.addEventListener("input", () => {
    if (!searchInput.value.trim()) {
      showAllPosts();
    }
  });

  searchInput.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" || event.isComposing) {
      return;
    }

    event.preventDefault();
    const query = searchInput.value.trim().toLocaleLowerCase();

    for (const post of postItems) {
      clearHighlights(post);
      const matches = !query || post.textContent?.toLocaleLowerCase().includes(query);
      post.hidden = !matches;

      if (matches && query) {
        highlightMatches(post, query);
      }
    }
  });
</script>

<style>
  nav {
    max-width: 740px;
    margin: 0 auto;
  }

  .category-search {
    box-sizing: border-box;
    width: 100%;
    margin-bottom: 16px;
    padding: 12px 14px;
    border: 1px solid #d8cec0;
    /* border-radius: 6px; */
    outline: none;
    color: #20343a;
    background: #fffdf8;
    box-shadow: 0 3px 12px rgb(54 44 30 / 4%);
    font: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .category-search::placeholder {
    color: #92958e;
  }

  .category-search:hover {
    border-color: #b9aa98;
  }

  .category-search:focus {
    border-color: #624b71;
    box-shadow: 0 0 0 3px rgb(98 75 113 / 14%);
  }

  nav > h1 {
    margin: 0 0 30px;
    color: #20343a;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  nav ul {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .post-items {
    padding: 22px 24px;
    border: 1px solid #e5ded2;
    background: #fffdf8;
    box-shadow: 0 5px 18px rgb(54 44 30 / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-items:hover {
    transform: translateY(-4px);
    box-shadow: 0 9px 24px rgb(54 44 30 / 9%);
  }

  .post-title {
    margin-bottom: 9px;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .post-title a {
    color: #20343a;
    text-decoration: none;
  }

  .post-title a:hover,
  .post-title a:focus-visible {
    color: #a04f32;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    color: #586568;
  }

  .post-updated {
    flex: 0 0 auto;
    padding-top: 2px;
    color: #85877f;
    font-size: 0.82rem;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 10px 8px;
    margin-top: 14px;
  }

  .post-tag {
    padding: 2px 8px;
    color: #624b71;
    background: #f0eaf3;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  :global(mark.search-highlight) {
    color: inherit;
    background-color: #ffeb7a;
  }

  @media (max-width: 600px) {
    .post-items {
      padding: 18px;
    }

    .post-title {
      font-size: 1.15rem;
    }
  }
</style>
