---
import { type CollectionEntry } from "astro:content";
import Base from "./base.astro";

interface Props {
  title: string;
  posts: CollectionEntry<"posts">[];
}

const { title, posts } = Astro.props;
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const description = `${title} 카테고리의 포스트 목록입니다.`;
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const structuredData = {
  "@type": "CollectionPage",
  "@id": `${canonicalURL.href}#collection`,
  url: canonicalURL.href,
  name: title,
  description,
  isPartOf: { "@id": new URL("#website", siteURL).href },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: posts.map((post, index) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return {
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "BlogPosting",
          name: post.data.title,
          description: post.data.description,
          url: new URL(`/post/${encodeURIComponent(postSlug)}`, siteURL).href,
        },
      };
    }),
  },
};
---

<Base props={{ title, description, canonicalURL, structuredData }}>
  <nav>
    <h1>{title}</h1>
    {posts.map((post) => {
      const postSlug = post.id.slice(post.id.indexOf("/") + 1);

      return (
        <ul>
          <li class="post-items">
            <div class="post-title"><a href={`/post/${postSlug}`}>{post.data.title}</a></div>
            <div class="post-description">{post.data.description}</div>
            <div class="post-updated">{post.data.updated}</div>
          </li>
        </ul>
      );
    })}
  </nav>
</Base>

<style>
  nav {
    max-width: 740px;
    margin: 0 auto;
  }

  nav > h1 {
    margin: 0 0 30px;
    color: #20343a;
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  nav ul {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
  }

  .post-items {
    padding: 22px 24px;
    border: 1px solid #e5ded2;
    background: #fffdf8;
    box-shadow: 0 5px 18px rgb(54 44 30 / 5%);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-items:hover {
    transform: translateY(-4px);
    box-shadow: 0 9px 24px rgb(54 44 30 / 9%);
  }

  .post-title {
    margin-bottom: 9px;
    font-size: 1.3rem;
    font-weight: 700;
  }

  .post-title a {
    color: #20343a;
    text-decoration: none;
  }

  .post-title a:hover,
  .post-title a:focus-visible {
    color: #a04f32;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-description {
    color: #586568;
  }

  .post-updated {
    margin-top: 14px;
    color: #85877f;
    font-size: 0.82rem;
  }

  @media (max-width: 600px) {
    .post-items {
      padding: 18px;
    }

    .post-title {
      font-size: 1.15rem;
    }
  }
</style>
