---
import Base from "./Base.astro";

interface PageMetadata {
  title?: string;
  description?: string;
  canonicalURL?: string | URL;
  siteName?: string;
  ogImage?: string | URL;
  ogImageAlt?: string;
  type?: "website" | "article";
  lang?: string;
  locale?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

interface Props {
  frontmatter?: PageMetadata;
}

const { frontmatter = {} } = Astro.props;
---

<Base props={frontmatter}>
  <article>
    {frontmatter.title && <h1>{frontmatter.title}</h1>}
    {frontmatter.description && <p>{frontmatter.description}</p>}
    <slot />
  </article>
</Base>

<style is:global>
  article {
    /* max-width: 740px;
    margin: 0 auto;
    padding: clamp(26px, 5vw, 54px);
    border: 1px solid #e8e0d4;
    background: #fffdf8;
    box-shadow: 0 12px 40px rgb(54 44 30 / 7%); */    
  }

  article > h1:first-child {
    margin: 0 0 14px;
    color: #20343a;
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.2;
    letter-spacing: -0.045em;
  }

  article > p:first-of-type {
    margin: 0 0 34px;
    padding-bottom: 26px;
    border-bottom: 1px solid #e9e1d6;
    color: #687578;
    font-size: 1.08rem;
  }

  article h1,
  article h2,
  article h3,
  article h4,
  article h5,
  article h6 {
    margin: 1.8em 0 0.65em;
    color: #263d43;
    line-height: 1.3;
  }

  article h1:not(:first-child) {
    font-size: 2rem;
  }

  article h2 {
    padding-bottom: 0.35em;
    border-bottom: 1px solid #e8e0d4;
    font-size: 1.7rem;
  }

  article h3 {
    font-size: 1.4rem;
  }

  article h4 {
    font-size: 1.2rem;
  }

  article h5 {
    font-size: 1.05rem;
  }

  article h6 {
    color: #85877f;
    font-size: 0.95rem;
  }

  article p,
  article ul,
  article ol {
    margin: 0 0 1.15em;
  }

  article ul,
  article ol {
    padding-left: 1.6em;
  }

  article ul {
    list-style: disc;
  }

  article ol {
    list-style: decimal;
  }

  article li + li {
    margin-top: 0.35em;
  }

  article blockquote {
    margin: 1.5em 0;
    padding: 14px 20px;
    border-left: 4px solid #bd7955;
    color: #586568;
    background: #f5f0e7;
  }

  article blockquote > :last-child {
    margin-bottom: 0;
  }

  article hr {
    margin: 2.5em 0;
    border: 0;
    border-top: 1px solid #e5ded2;
  }

  article a {
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  article img,
  article svg {
    max-width: 100%;
    height: auto;
  }

  article pre {
    overflow-x: auto;
    margin: 1.5em 0;
    padding: 20px;
    border: 1px solid #263d43;
    color: #edf3ee;
    background: #20343a;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  article :not(pre) > code {
    padding: 0.15em 0.4em;
    color: #8b452f;
    background: #f2e9dd;
    font-size: 0.9em;
  }

  article table {
    display: block;
    width: 100%;
    overflow-x: auto;
    margin: 1.5em 0;
    border-collapse: collapse;
    font-size: 0.94rem;
  }

  article th,
  article td {
    padding: 10px 13px;
    border: 1px solid #e2d9cc;
    text-align: left;
  }

  article th {
    color: #20343a;
    background: #f2ede4;
  }

  article tr:nth-child(even) td {
    background: #faf7f1;
  }

  article input[type="checkbox"] {
    margin-right: 0.5em;
    accent-color: #52756a;
  }

  article kbd {
    padding: 0.15em 0.45em;
    border: 1px solid #d2c9bc;
    background: #f5f0e7;
    box-shadow: 0 1px 0 #d2c9bc;
    font-size: 0.85em;
  }

  article details {
    margin: 1.25em 0;
    padding: 12px 16px;
    border: 1px solid #e5ded2;
    background: #faf7f1;
  }

  article summary {
    color: #263d43;
    cursor: pointer;
    font-weight: 700;
  }

  article mark {
    padding: 0.1em 0.25em;
    background: #f4df9b;
  }

  @media (max-width: 600px) {
    article {
      padding: 22px 18px;
    }

    article pre {
      padding: 15px;
    }
  }
</style>
