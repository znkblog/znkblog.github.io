---
import "reset-css/reset.css";
import "../styles/global.css";
import Header from "./Header.astro";
import Adsense from "./Adsense.astro";
import Menu from "./Menu.astro";
import Footer from "./Footer.astro";

interface SeoProps {
  title?: string;
  description?: string;
  canonicalURL?: string | URL;
  siteName?: string;
  ogImage?: string | URL;
  ogImageAlt?: string;
  type?: "website" | "article";
  lang?: string;
  locale?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

interface Props {
  props?: SeoProps;
}

const { props = {} } = Astro.props;
const siteName = props.siteName ?? "찌니코 블로그";
const title = props.title ?? siteName;
const description =
  props.description ?? "문과 출신 IT 비전공 기획업무 종사자 찌니꼬가 IT에 관심을 가지고 배우며 알게 된 내용을 기록하는 블로그";
const siteURL = Astro.site ?? new URL("https://znkblog.github.io");
const canonicalURL = new URL(props.canonicalURL ?? Astro.url.pathname, siteURL);
const ogImage = new URL(props.ogImage ?? "/og-image.png", siteURL);
const lang = props.lang ?? "ko";
const locale = props.locale ?? "ko_KR";
const robots = props.noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("#website", siteURL).href,
      url: siteURL.href,
      name: siteName,
      description,
      inLanguage: lang,
    },
    {
      "@type": "Organization",
      "@id": new URL("#organization", siteURL).href,
      name: siteName,
      url: siteURL.href,
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { "@id": new URL("#website", siteURL).href },
    },
    ...(props.structuredData ? [props.structuredData] : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MXR6Z4099H"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MXR6Z4099H');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === siteName ? title : `${title} | ${siteName}`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={props.type ?? "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={props.ogImageAlt ?? `${siteName} 공유 이미지`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
    <slot name="head" />
  </head>
  <body>
    <div id="layout">
      <div id="container">
        <div id="sidebar">
          <div id="header-wrapper">
            <Header />
          </div>
          <div id="adsense-wrapper">
            <Adsense />
          </div>
          <div id="menu-wrapper">
            <Menu />
          </div>
          <div id="footer-wrapper">
            <Footer />
          </div>
        </div>
        <button id="sidebar-toggle" type="button" aria-controls="sidebar" aria-expanded="false" aria-label="메뉴 열기">
          <span class="icon circle-16" aria-hidden="true"></span>
        </button>
        <div id="mainview">
          <main>
            <slot />
          </main>
        </div>
      </div>
    </div>
  </body>
</html>

<script>
  const container = document.querySelector<HTMLElement>("#container");
  const sidebarToggle = document.querySelector<HTMLButtonElement>("#sidebar-toggle");
  const menuIcon = sidebarToggle?.querySelector("span");

  if (!container || !sidebarToggle || !menuIcon) {
    throw new Error("Mobile menu elements are missing.");
  }

  sidebarToggle.addEventListener("click", () => {
    const isOpen = container.classList.toggle("menu-open");
    sidebarToggle.setAttribute("aria-expanded", String(isOpen));
    sidebarToggle.setAttribute("aria-label", isOpen ? "메뉴 닫기" : "메뉴 열기");
  });
</script>
