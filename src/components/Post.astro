---
import Base from './Base.astro';

const { title, description, updated } = Astro.props;
---

<Base>
<main>
    <h1 id="page-title" class="center">{ title }</h1>
    <div class="meta">
      <div>📢 { description }</div>
      <div>🗓️ Last updated: { updated.split("T")[0] || "" }</div>
    </div>
    <slot />
</main>
</Base>

<style lang="scss" is:global>
  main {
    .meta {
      margin: 3rem 0;
    }
    h1 {
      margin: 3rem 0;

      &:before {
        content: "📝";
      }
    }
    h2 {
      margin: 3rem 0 1rem 0;

      &:before {
        content: "✅";
      }
    }
  }
</style>